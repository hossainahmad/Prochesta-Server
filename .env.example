# MongoDB Atlas database (same DB as the client assignment project)
DATABASE_URL="mongodb+srv://CHANGE_ME:CHANGE_ME@CHANGE_ME.mongodb.net/volunify?retryWrites=true&w=majority"

# Secret used to sign JWTs — must match AUTH_TOKEN_SECRET in the client .env
JWT_SECRET="replace-with-your-own-secret"

# Where the Next.js client runs (used for CORS + OAuth redirects)
CLIENT_URL="http://localhost:3000"

# HTTP port the API listens on
PORT=3001

# OPTIONAL — Google login (leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
